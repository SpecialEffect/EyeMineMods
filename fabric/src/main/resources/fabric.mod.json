{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "Kirsty McNaught", "Mrbysco"
  ],
  "contact": {
    "homepage": "https://www.specialeffect.org.uk/eyemine",
    "sources": "https://github.com/SpecialEffect/SpecialEffectMinecraftMods"
  },
  "license": "${license}",
  "icon": "eyemine_logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.specialeffect.eyemine.EyeMineFabric"
    ],
    "client": [
      "com.specialeffect.eyemine.EyeMineClientFabric"
    ]
  },
  "mixins": [
    "eyemine-common.mixins.json",
    "eyemine.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "cloth-config": ">=14"
  }
}
